@model IEnumerable<LMS.Models.Orderdetail>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Weightinkg)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subtotal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Weightinkg)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Subtotal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Order.Orderid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Service.Serviceid)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Orderdetailid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Orderdetailid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Orderdetailid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
